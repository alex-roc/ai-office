{
  "name": "ai-office",
  "displayName": "ai-office",
  "version": "0.1.0",
  "description": "See, edit and measure your Claude Code agents, skills and slash commands: a pixel-art office, a live graph, safe edits with diffs, and real usage from your transcripts.",
  "author": {
    "name": "Alex Ojeda Copa",
    "url": "https://github.com/alex-roc"
  },
  "license": "MIT",
  "keywords": ["skills", "agents", "visualization", "audit", "graph"],
  "commands": ["./commands/"],
  "hooks": "./hooks/hooks.json",
  "userConfig": {
    "port": {
      "type": "number",
      "description": "Local port of the interface",
      "default": 7377,
      "min": 1024,
      "max": 65535,
      "title": "Port"
    },
    "telemetry": {
      "type": "boolean",
      "description": "Record session activity to fill in the detail cards. Everything stays on your disk.",
      "default": true,
      "title": "Record activity"
    },
    "language": {
      "type": "string",
      "description": "Interface language: en or es",
      "default": "en",
      "title": "Language"
    }
  },
  "homepage": "https://alex-roc.github.io/ai-office/",
  "repository": "https://github.com/alex-roc/ai-office",
  "icon": "./.claude-plugin/icon.png"
}
