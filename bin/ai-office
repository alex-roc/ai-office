#!/usr/bin/env node
// Punto de entrada cuando ai-office se instala como plugin: el directorio `bin/` del plugin
// entra en el PATH de la herramienta Bash, así que `ai-office` queda disponible sin instalar nada.
//
// Opciones del plugin (`userConfig` de .claude-plugin/plugin.json): Claude Code las expone como
// CLAUDE_PLUGIN_OPTION_<CLAVE>. `port` lo lee la propia CLI (`packages/cli/src/env.ts`, junto con
// `AI_OFFICE_PORT`, que vale fuera del plugin), `language` también la CLI (`packages/cli/src/i18n.ts`)
// y `telemetry` el relay de hooks. Aquí solo se comprueba que el plugin tenga sus dependencias,
// para no mostrar un stack trace de ERR_MODULE_NOT_FOUND. Esos dos avisos salen antes de que la
// CLI exista, así que llevan sus dos idiomas aquí mismo (mismo orden de resolución que la CLI,
// inglés por defecto).

import { spawn } from 'node:child_process'
import { createRequire } from 'node:module'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'

const langArg = process.argv.find((a) => a.startsWith('--lang='))?.slice(7)
const langFlag = process.argv.indexOf('--lang')
const wanted = (
  langArg ??
  (langFlag >= 0 ? process.argv[langFlag + 1] : undefined) ??
  process.env.AI_OFFICE_LANG ??
  process.env.CLAUDE_PLUGIN_OPTION_LANGUAGE ??
  'en'
)
  .trim()
  .toLowerCase()
const es = wanted === 'es'

const here = dirname(fileURLToPath(import.meta.url))
const root = join(here, '..')
const cli = join(root, 'packages', 'cli', 'src', 'index.ts')

// El plugin ejecuta TypeScript directamente: Node lo admite sin bandera desde la 22.18. Con una
// versión anterior el error sería un ERR_UNKNOWN_FILE_EXTENSION que no dice qué hacer.
const [major, minor] = process.versions.node.split('.').map(Number)
if (major < 22 || (major === 22 && minor < 18)) {
  console.error(
    es
      ? `ai-office necesita Node 22.18 o posterior (tienes ${process.versions.node}): ejecuta TypeScript sin compilar.`
      : `ai-office needs Node 22.18 or later (you have ${process.versions.node}): it runs TypeScript without compiling.`,
  )
  process.exit(1)
}

// El plugin se clona sin node_modules. Con pnpm cada paquete del monorepo tiene los suyos, así que
// se resuelve desde el paquete que los usa en vez de mirar una carpeta concreta.
const resolvesFrom = (pkg, dep) => {
  try {
    createRequire(join(root, 'packages', pkg, 'package.json')).resolve(dep)
    return true
  } catch {
    return false
  }
}
const missing = [
  ['daemon', 'fastify'],
  ['providers', 'yaml'],
]
  .filter(([pkg, dep]) => !resolvesFrom(pkg, dep))
  .map(([, dep]) => dep)
if (missing.length > 0) {
  console.error(
    es
      ? `ai-office: faltan las dependencias del plugin (${missing.join(', ')}).\n` +
          'Instálalas una sola vez con:\n\n' +
          `  cd "${root}" && pnpm install --prod\n`
      : `ai-office: the plugin's dependencies are missing (${missing.join(', ')}).\n` +
          'Install them once with:\n\n' +
          `  cd "${root}" && pnpm install --prod\n`,
  )
  process.exit(1)
}

const child = spawn(process.execPath, [cli, ...process.argv.slice(2)], { stdio: 'inherit' })
child.on('error', (err) => {
  console.error(
    es
      ? `ai-office: no se pudo arrancar (${err.message})`
      : `ai-office: could not start (${err.message})`,
  )
  process.exit(1)
})
child.on('exit', (code) => {
  process.exit(code ?? 0)
})
