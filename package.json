{
  "name": "ai-office-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "censo": "node packages/cli/src/index.ts censo",
    "typecheck": "tsc -b --pretty",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "node --test --test-timeout=30000 \"packages/**/test/*.test.ts\" \"apps/**/test/*.test.ts\"",
    "dev": "node packages/cli/src/index.ts start",
    "dev:web": "pnpm --filter @ai-office/web dev",
    "build:web": "pnpm --filter @ai-office/web build",
    "build": "bash scripts/build.sh",
    "verificar:paquete": "bash scripts/verificar-paquete.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^24.10.1",
    "pngjs": "^7.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
